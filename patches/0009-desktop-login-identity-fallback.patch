+/**
+ * own（patch 0009）：桌面登录不写 CLI 的 identity 键。Registry 侧从共享 user_info
+ * 推导同一账号身份让模型可见；请求侧不做推导——缺键时抛出可执行指引（/login 一次）。
+ */
+function readStandaloneUserIdentity(input: {
+  readonly storedIdentity?: string | null;
+  readonly userInfo?: string | null;
+}): string | undefined {
+  const stored = input.storedIdentity?.trim();
+  if (stored) return stored;
+  if (!input.userInfo) return undefined;
+  try {
+    const parsed = JSON.parse(input.userInfo) as { user_id?: unknown; id?: unknown };
+    if (typeof parsed.user_id === "string" && parsed.user_id.trim()) return parsed.user_id.trim();
+    if (typeof parsed.id === "string" && parsed.id.trim()) return parsed.id.trim();
+    return undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function sharedUserInfoCredentialKey(family: ProviderFamilyDomain): string {
+  return family === "zai"
+    ? SHARED_ZCODE_CREDENTIAL_KEYS.zaiUserInfo
+    : SHARED_ZCODE_CREDENTIAL_KEYS.bigmodelUserInfo;
