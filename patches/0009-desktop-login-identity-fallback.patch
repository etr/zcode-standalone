+  // Registry 刷新 → 在飞请求 scope_invalidated（并发 title 生成即触发）。
+  // 见 headers port 的 derivedLogin 守卫。
+  if (!input.userInfo) return undefined;
+  try {
+    const parsed = JSON.parse(input.userInfo) as { user_id?: unknown; id?: unknown };
+    const derived =
+      typeof parsed.user_id === "string" && parsed.user_id.trim()
+        ? parsed.user_id.trim()
+        : typeof parsed.id === "string" && parsed.id.trim()
+          ? parsed.id.trim()
+          : undefined;
+    return derived;
+  } catch {
+    return undefined;
+  }
+}
