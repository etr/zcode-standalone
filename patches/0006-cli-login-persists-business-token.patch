+/** own（patch 0006）：z/login 兑换业务 token；桌面端登录的同一转换步骤。 */
+async function exchangeZaiBusinessToken(input: {
+  accessToken: string;
+  env: EnvRecord;
+  httpClient?: Parameters<typeof createCodingPlanApiKeyResolver>[0]["httpClient"];
+  signal?: AbortSignal;
+}): Promise<string | undefined> {
+  input.signal?.throwIfAborted();
+  const httpClient = input.httpClient ?? createDefaultHttpClient(input.env);
+  const response = await httpClient.request(
+    {
+      url: buildRuntimeZaiBusinessUrl(input.env, "/api/auth/z/login"),
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: new TextEncoder().encode(JSON.stringify({ token: input.accessToken })),
+      maxResponseBytes: 64 * 1024,
+      timeoutMs: 30_000,
+    },
+    {},
   );
+  if (response.status < 200 || response.status >= 300) return undefined;
+  const body = JSON.parse(new TextDecoder().decode(response.body)) as {
+    code?: unknown;
+    data?: { access_token?: string; accessToken?: string };
+  };
+  if (body.code != null && ![0, 200, "0", "200"].includes(body.code as number)) {
+    return undefined;
+  }
+  return body.data?.access_token?.trim() || body.data?.accessToken?.trim() || undefined;
 }
