+
+/** CLI OAuth token 是带 iat/exp 的三段 JWT；桌面业务 token（含 api_key 声明、无 iat）或
+ * 不透明串都不是。只有前者需要走 z/login 换业务 token。 */
+function looksLikeCliOauthToken(token: string): boolean {
+  const segments = token.split(".");
+  if (segments.length !== 3) return false;
+  try {
+    const claims: unknown = JSON.parse(Buffer.from(segments[1]!, "base64url").toString("utf8"));
+    return typeof claims === "object" && claims !== null && "iat" in claims;
+  } catch {
+    return false;
+  }
+}
