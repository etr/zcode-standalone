+interface StandaloneStartPlanState {
+  readonly entitled: boolean;
+  readonly modelIds: readonly string[];
+}
+
+const standaloneStartPlanCache = new Map<
+  string,
+  { expiresAt: number; state: StandaloneStartPlanState }
+>();
+const STANDALONE_START_PLAN_TTL_MS = 5 * 60_000;
+
+async function readStandaloneStartPlanState(
+  env: Readonly<Record<string, string | undefined>>,
+  credentialStore: Pick<SharedZCodeCredentialStore, "loadMany" | "load">,
+): Promise<StandaloneStartPlanState> {
+  const empty: StandaloneStartPlanState = { entitled: false, modelIds: [] };
+  const jwt = (await credentialStore.load(SHARED_ZCODE_CREDENTIAL_KEYS.zcodeJwtToken))?.trim();
+  if (!jwt) return empty;
+  const cacheKey = createHash("sha256").update(jwt).digest("hex");
+  const cached = standaloneStartPlanCache.get(cacheKey);
+  if (cached && cached.expiresAt > Date.now()) return cached.state;
+  const state = await fetchStandaloneStartPlanState(env, jwt).catch(() => empty);
+  standaloneStartPlanCache.set(cacheKey, {
+    expiresAt: Date.now() + STANDALONE_START_PLAN_TTL_MS,
+    state,
+  });
+  return state;
+}
+
+async function fetchStandaloneStartPlanState(
+  env: Readonly<Record<string, string | undefined>>,
+  jwt: string,
+): Promise<StandaloneStartPlanState> {
+  const config = createConfig({ env }).config;
+  const httpClient = createNodeHttpClientAdapter({
+    env,
+    proxyUrl: config.network.httpProxy,
+    noProxy: config.network.noProxy,
+    caCertFile: config.network.caCertFile,
+    timeoutMs: config.network.timeout,
+  });
+  // app_version 按真实引擎版本上报（诚实标识；后端可据此拒绝非桌面客户端 = fail-closed）。
+  const appVersion = env.ZCODE_APP_VERSION?.trim() || "0.17.1";
+  const url = `https://zcode.z.ai/api/v1/zcode-plan/billing/balance?app_version=${encodeURIComponent(appVersion)}`;
+  const response = await httpClient.request(
+    {
+      url,
+      method: "GET",
+      headers: { Authorization: `Bearer ${jwt}` },
+      maxResponseBytes: 128 * 1024,
+      timeoutMs: 15_000,
+    },
+    {},
+  );
+  if (response.status < 200 || response.status >= 300) {
+    return { entitled: false, modelIds: [] };
+  }
+  const payload = JSON.parse(new TextDecoder().decode(response.body)) as {
+    code?: unknown;
+    data?: {
+      plans?: Array<{ plan_id?: string; name?: string; status?: string; ends_at?: number }>;
+      balances?: Array<{ capabilities?: string[] }>;
+    };
+  };
+  if (payload.code != null && ![0, 200, "0", "200"].includes(payload.code as number)) {
+    return { entitled: false, modelIds: [] };
+  }
+  const nowSeconds = Date.now() / 1000;
+  const isStartPlanIdentity = (value?: string): boolean => {
+    const normalized = (value ?? "").trim().toLowerCase();
+    return normalized.includes("start-plan") || normalized.includes("start plan");
+  };
+  const plans = (payload.data?.plans ?? []).map((plan) => {
+    const status = plan.status?.trim().toLowerCase() ?? "";
+    const endsAt = Number(plan.ends_at);
+    const expired =
+      Number.isFinite(endsAt) && endsAt > 0 && endsAt <= nowSeconds ? "expired" : status;
+    return { planId: (plan.plan_id ?? "").trim().toLowerCase(), name: (plan.name ?? "").trim().toLowerCase(), status: expired };
+  });
+  const entitled = plans.some(
+    (plan) => plan.status === "active" && (isStartPlanIdentity(plan.planId) || isStartPlanIdentity(plan.name)),
+  );
+  const modelIds: string[] = [];
+  const seen = new Set<string>();
+  for (const balance of payload.data?.balances ?? []) {
+    for (const capability of balance.capabilities ?? []) {
+      const normalized = capability.trim();
+      if (!normalized.toLowerCase().startsWith("model:")) continue;
+      const modelId = normalized.slice("model:".length).trim();
+      const key = modelId.toLowerCase();
+      if (modelId && !seen.has(key)) {
+        seen.add(key);
+        modelIds.push(modelId);
+      }
+    }
+  }
+  return { entitled, modelIds };
 }
 
