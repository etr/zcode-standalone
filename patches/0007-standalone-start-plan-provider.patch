+/** own（patch 0007）：start-plan 权益按账号 balance 接口判定（桌面端同源语义），带 TTL 缓存。 */
+function readStandaloneStartPlanProviders(
+  providers: ProviderConfigLayerSnapshot["providers"],
+): readonly { family: ProviderFamilyDomain; providerId: string }[] {
+  return providers.entries().flatMap(([providerId, provider]) => {
+    const access = provider.access;
+    return access?.type === "zhipu-account" &&
+      access.mode === "start-plan" &&
+      access.accountType
+      ? [{ family: access.accountType, providerId }]
+      : [];
+  });
+}
