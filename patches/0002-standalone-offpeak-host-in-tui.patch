index 00000000..0aaf171d
--- /dev/null
+++ b/apps/zcode-cli/packages/cli/src/standalone-offpeak-host.ts
@@ -0,0 +1,338 @@
+/**
+ * standalone-offpeak-host.ts — standalone off-peak host for the TUI (always on).
+ *
+ * 桌面端把 off-peak 队列放在 Electron host；这里把同一套 packages/services 队列
+ * （OffPeakTaskService/Repo/ServerClient，全部与 Electron 无关）跑在 TUI 进程内：
+ *   - OffPeakPort.create/list 直接落 OffPeakTaskService（先取号后落库，与桌面一致）
+ *   - 20s 调度循环 claimDue → 通过注入的 dispatch 回调跑一个专用会话 → markTerminal
+ *   - 票据轮询/核销由 Service 自身的 startSync 完成；本模块只补派发。
+ *
+ * 合规约束：票据请求携带真实账号凭据（oauth token 解出的 coding-plan key + JWT），
+ * 服务端保留授予与否的最终决定权（3101/3103 原样透传，绝不重试绕过）。
+ * 调度仅在 TUI 进程存活期间运行——关闭终端即暂停派发，票据轮询随之停止。
+ */
+import { createHash } from "node:crypto";
+import {
+  createCodingPlanApiKeyResolver,
+  createSharedZCodeCredentialStore,
+  SHARED_ZCODE_CREDENTIAL_KEYS,
+} from "@zcode/adapters/auth";
+import { createNodeHttpClientAdapter } from "@zcode/adapters/http";
+import { createConfig } from "@zcode/adapters/config";
+import type { OffPeakPort, OffPeakCreateOutcome, OffPeakTaskSummary } from "@zcode/contracts";
+import type { ModelSelection } from "@zcode/shared";
+import type { OffPeakLifecycleNotification, ZCodeOffPeakTask } from "@zcode/shared";
+import {
+  createOffPeakOriginResolver,
+  createOffPeakServerClient,
+  createServiceLogger,
+  OffPeakTaskRepo,
+  OffPeakTaskService,
+} from "@zcode/services/node";
+
+const TICK_MS = 20_000;
+
+export interface OwnOffPeakDispatchMaterial {
+  readonly requestAuth: {
+    readonly apiKey: string;
+    readonly headers: Readonly<Record<string, string>>;
+  };
+  readonly modelSelection: ModelSelection;
+}
+
+export interface OwnOffPeakHost {
+  readonly port: OffPeakPort;
+  onLifecycleEvent(event: OffPeakLifecycleNotification): void;
+  start(): void;
+  stop(): Promise<void>;
+}
+
+export interface OwnOffPeakHostOptions {
+  readonly env: NodeJS.ProcessEnv;
+  readonly workingDirectory: string;
+  /** 派发回调：为任务跑一个专用会话；permanent=true 时任务直接终败。 */
+  readonly dispatch: (
+    task: ZCodeOffPeakTask,
+    material: OwnOffPeakDispatchMaterial,
+  ) => Promise<{ ok: true } | { ok: false; permanent: boolean; error: string }>;
+}
+
+interface ResolvedCredentials {
+  readonly family: "zai" | "bigmodel";
+  readonly jwt: string;
+  readonly codingPlanApiKey: string;
+  readonly providerId: string;
+}
+
+const OFF_PEAK_PROVIDER_IDS = {
+  zai: "account:zai-offpeak-idle-plan",
+  bigmodel: "account:bigmodel-offpeak-idle-plan",
+} as const;
+
+export async function createOwnOffPeakHost(options: OwnOffPeakHostOptions): Promise<OwnOffPeakHost> {
+  const logger = createServiceLogger("own-offpeak");
+  const env = options.env;
+  const credentialStore = createSharedZCodeCredentialStore({ env });
+  const config = createConfig({ env }).config;
+  const resolver = createCodingPlanApiKeyResolver({
+    httpClient: createNodeHttpClientAdapter({
+      env,
+      proxyUrl: config.network.httpProxy,
+      noProxy: config.network.noProxy,
+      caCertFile: config.network.caCertFile,
+      timeoutMs: config.network.timeout,
+    }),
+    locationStore: credentialStore,
+  });
+  const originResolver = createOffPeakOriginResolver({
+    logger,
+    env,
+    // mock 网关把 messages 原样代理到真实模型端点（用户自己的 key，与生产同计费口径）。
+    resolveUpstream: async () => {
+      const resolved = await resolveCredentials();
+      return {
+        url: resolved.family === "zai"
+          ? "https://api.z.ai/api/anthropic/v1/messages"
+          : "https://open.bigmodel.cn/api/anthropic/v1/messages",
+        headers: {
+          authorization: `Bearer ${resolved.jwt}`,
+          "x-coding-plan-api-key": resolved.codingPlanApiKey,
+          "x-off-peak-ticket-id": "mock",
+        },
+      };
+    },
+  });
+
+  async function resolveCredentials(): Promise<ResolvedCredentials> {
+    const zaiToken = (await credentialStore.load(SHARED_ZCODE_CREDENTIAL_KEYS.zaiAccessToken))?.trim();
+    const bigmodelToken = zaiToken
+      ? undefined
+      : (await credentialStore.load(SHARED_ZCODE_CREDENTIAL_KEYS.bigmodelAccessToken))?.trim();
+    const family: "zai" | "bigmodel" = zaiToken ? "zai" : "bigmodel";
+    const accessToken = family === "zai" ? zaiToken : bigmodelToken;
+    const jwt = (await credentialStore.load(SHARED_ZCODE_CREDENTIAL_KEYS.zcodeJwtToken))?.trim();
+    if (!accessToken || !jwt) throw new Error("own-offpeak: project_token_login_required");
+    const identity = (
+      await credentialStore.load(`account-provider:account:${family}-individual-coding-plan:identity`)
+    )?.trim();
+    const providerId = `account:${family}-individual-coding-plan`;
+    if (!identity) throw new Error("own-offpeak: project_token_account_required");
+    const material = await resolver.resolveMaterial({
+      family,
+      accessToken,
+      accountIdentity: identity,
+    });
+    if (!material.token) throw new Error("own-offpeak: project_token_resolve_failed");
+    return { family, jwt, codingPlanApiKey: material.token, providerId };
+  }
+
+  const repo = new OffPeakTaskRepo();
+  const service = new OffPeakTaskService({
+    repo,
+    client: createOffPeakServerClient({
+      resolveOrigin: originResolver.resolveOrigin,
+      resolveCredentials: async () => {
+        const resolved = await resolveCredentials();
+        return {
+          jwt: resolved.jwt,
+          codingPlanApiKey: resolved.codingPlanApiKey,
+          kind: resolved.family === "zai" ? "zai-personal" : "bigmodel-personal",
+          providerFamily: resolved.family,
+          providerId: resolved.providerId,
+        };
+      },
+      logger,
+    }),
+    resolveCodingPlanSupport: async () => {
+      try {
+        const resolved = await resolveCredentials();
+        const kind = resolved.family === "zai" ? "zai-personal" : "bigmodel-personal";
+        return { supported: true, kind, providerFamily: resolved.family, providerId: resolved.providerId };
+      } catch {
+        return { supported: false, reason: "connection_unavailable" };
+      }
+    },
+    resolveTelemetryProviderName: async () => "",
+    resolveModelSelection: async (input) => {
+      try {
+        const resolved = await resolveCredentials();
+        const modelId = input.modelId ?? "GLM-5.3";
+        return {
+          ok: true as const,
+          selection: {
+            providerId: OFF_PEAK_PROVIDER_IDS[resolved.family],
+            modelId,
+            ...(input.reasoningLevel ? { options: { reasoningLevel: input.reasoningLevel } } : {}),
+          } as ModelSelection,
+        };
+      } catch (error) {
+        return {
+          ok: false as const,
+          validation: {
+            ok: false as const,
+            code: "provider-not-found" as const,
+            providerId: OFF_PEAK_PROVIDER_IDS.zai,
+          },
+        };
+      }
+    },
+    logger,
+    requestSchedulerWake: () => wakeScheduler(),
+    stopRunningTask: async () => undefined,
+  });
+
+  let timer: NodeJS.Timeout | undefined;
+  let wake: (() => void) | undefined;
+  const wakeScheduler = () => wake?.();
+
+  async function runTick(): Promise<void> {
+    try {
+      const claimed = await repo.claimDue(Date.now());
+      for (const task of claimed) {
+        await handleClaimed(task).catch((error) =>
+          logger.error("dispatch failed", { taskId: task.offPeakTaskId, error: String(error) }),
+        );
+      }
+    } catch (error) {
+      logger.error("tick failed", { error: String(error) });
+    }
+  }
+
+  async function handleClaimed(task: ZCodeOffPeakTask): Promise<void> {
+    let resolved: ResolvedCredentials;
+    try {
+      resolved = await resolveCredentials();
+    } catch (error) {
+      await repo.markTerminal(task.offPeakTaskId, { status: "failed", endedAt: Date.now(), failureReason: String(error).slice(0, 500) });
+      return;
+    }
+    const requestAuth = {
+      apiKey: resolved.jwt,
+      headers: {
+        Authorization: `Bearer ${resolved.jwt}`,
+        "X-Coding-Plan-Api-Key": resolved.codingPlanApiKey,
+        "X-Off-Peak-Ticket-ID": task.serverTicketId ?? "",
+      },
+    };
+    const modelSelection: ModelSelection = {
+      providerId: OFF_PEAK_PROVIDER_IDS[resolved.family],
+      modelId: task.modelSelection?.modelId ?? "GLM-5.3",
+    };
+    const result = await options.dispatch(task, { requestAuth, modelSelection });
+    if (result.ok) {
+      await repo.markTerminal(task.offPeakTaskId, { status: "completed", endedAt: Date.now() });
+    } else {
+      await repo.markTerminal(task.offPeakTaskId, {
+        status: "failed",
+        endedAt: Date.now(),
+        failureReason: result.error.slice(0, 500),
+      });
+      if (!result.permanent) await repo.releaseClaim(task.offPeakTaskId);
+    }
+  }
+
+  const host: OwnOffPeakHost = {
+    port: {
+      async create(input): Promise<OffPeakCreateOutcome> {
+        try {
+          const support = await (async () => {
+            const resolved = await resolveCredentials();
+            return { resolved, modelId: input.model ?? "GLM-5.3" };
+          })();
+          const result = await service.createTask({
+            title: input.title,
+            prompt: input.prompt,
+            permissionMode: input.permissionMode ?? "yolo",
+            modelSelection: {
+              providerId: OFF_PEAK_PROVIDER_IDS[support.resolved.family],
+              modelId: support.modelId,
+              ...(input.thoughtLevel ? { options: { reasoningLevel: input.thoughtLevel } } : {}),
+            },
+            workspacePath: options.workingDirectory,
+            hostId: "zcode-own-tui",
+          });
+          if (!result.ok) {
+            return {
+              ok: false,
+              failureStage: result.failureStage,
+              errorCategory: result.errorCategory,
+              errorCode: result.errorCode,
+            };
+          }
+          return { ok: true, task: toSummary(result.task) };
+        } catch (error) {
+          return {
+            ok: false,
+            failureStage: "ticket_request" as const,
+            errorCategory: "network" as const,
+            errorCode: String(error).slice(0, 200),
+          };
+        }
+      },
+      async list(): Promise<OffPeakTaskSummary[]> {
+        const tasks = await service.list();
+        return tasks
+          .filter((task) => task.workspacePath === options.workingDirectory)
+          .slice(0, 20)
+          .map(toSummary);
+      },
+    },
+    onLifecycleEvent(event) {
+      // v1：completed 由 dispatch 回调收敛；ticket_needed 无续票实现，按桌面语义任务失败。
+      if (event.type === "ticket_needed") {
+        void repo
+          .get(event.offPeakTaskId)
+          .then((task) =>
+            task
+              ? repo.markTerminal(task.offPeakTaskId, {
+                  status: "failed",
+                  endedAt: Date.now(),
+                  failureReason: "off-peak-ticket-expired",
+                })
+              : undefined,
+          )
+          .catch(() => undefined);
+      }
+    },
+    start() {
+      if (timer) return;
+      service.startSync();
+      timer = setInterval(() => void runTick(), TICK_MS);
+      wake = () => {
+        setImmediate(() => void runTick());
+      };
+    },
+    async stop() {
+      if (timer) clearInterval(timer);
+      timer = undefined;
+      wake = undefined;
+      await service.disposeAll?.();
+      await repo.close?.();
+      await originResolver.close();
+    },
+  };
+  return host;
+}
+
+function toSummary(task: ZCodeOffPeakTask): OffPeakTaskSummary {
+  return {
+    offPeakTaskId: task.offPeakTaskId,
+    title: task.title,
+    status: task.status,
+    ...(task.queuePosition ? { queuePosition: task.queuePosition } : {}),
+    ...(task.sessionId ? { sessionId: task.sessionId } : {}),
+    createdAt: task.createdAt,
+  };
+}
+
+// 保留引用以明确账户 scope 派生与 headers-port 同式（供未来续票使用）。
+export function ownOffPeakAccountScope(input: {
+  providerId: string;
+  family: "zai" | "bigmodel";
+  identity: string;
+  accessToken: string;
+}): string {
+  return createHash("sha256")
+    .update(JSON.stringify([input.providerId, input.family, input.identity, input.accessToken]))
+    .digest("hex");
+}
